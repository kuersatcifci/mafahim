 {
  "@id": "https://w3id.org/mafahim/ontology",
  "@type": [
   "http://www.w3.org/2002/07/owl#Ontology"
  ],
  "http://purl.org/dc/terms/created": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-19"
   }
  ],
  "http://purl.org/dc/terms/creator": [
   {
    "@value": "Kürşat Çifçi"
   }
  ],
  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "Ontology for classical Quran commentaries (tafsir): works and editions, source-anchored statement units, cross-work interpretations and questions, concepts in their lived meaning (mafhūm), and review status. Extends SemanticTafsir."
   }
  ],
  "http://purl.org/dc/terms/license": [
   {
    "@id": "https://creativecommons.org/licenses/by/4.0/"
   }
  ],
  "http://purl.org/dc/terms/modified": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#date",
    "@value": "2026-10-21"
   }
  ],
  "http://purl.org/dc/terms/source": [
   {
    "@id": "https://github.com/talhaahmed884/SemanticTafsirKG"
   }
  ],
  "http://purl.org/dc/terms/title": [
   {
    "@language": "ar",
    "@value": "مفاهيم القرآن في تفاسير علماء الأمة"
   },
   {
    "@language": "en",
    "@value": "Mafāhīm: Quranic concepts in classical tafsir"
   },
   {
    "@language": "tr",
    "@value": "Mafāhīm: Kur'an kavramları klasik tefsirlerde"
   },
   {
    "@language": "de",
    "@value": "Mafāhīm: Koranbegriffe in den klassischen Tefsiren"
   }
  ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix": [
   {
    "@value": "mfh"
   }
  ],
  "http://purl.org/vocab/vann/preferredNamespaceUri": [
   {
    "@value": "https://w3id.org/mafahim/ontology#"
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#comment": [
   {
    "@language": "de",
    "@value": "Erweitert SemanticTafsir um mehrere Werke, zerlegte Aussage-Einheiten, werkübergreifende Deutungen, gelebte Begriffe (Mafhûm) und Prüfvermerke."
   }
  ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
   {
    "@id": "https://github.com/kuersatcifci/mafahim"
   }
  ],
  "http://www.w3.org/2002/07/owl#versionIRI": [
   {
    "@id": "https://w3id.org/mafahim/ontology/0.1.0"
   }
  ],
