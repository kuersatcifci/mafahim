  <rdf:Description rdf:about="https://w3id.org/mafahim/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/mafahim/ontology/0.1.0"/>
    <owl:versionInfo>0.1.0 (draft)</owl:versionInfo>
    <vann:preferredNamespacePrefix>mfh</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/mafahim/ontology#</vann:preferredNamespaceUri>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-21</dct:modified>
    <dct:source rdf:resource="https://github.com/talhaahmed884/SemanticTafsirKG"/>
    <rdfs:seeAlso rdf:resource="https://github.com/kuersatcifci/mafahim"/>
    <dct:description xml:lang="en">Ontology for classical Quran commentaries (tafsir): works and editions, source-anchored statement units, cross-work interpretations and questions, concepts in their lived meaning (mafhūm), and review status. Extends SemanticTafsir.</dct:description>
    <dct:title xml:lang="ar">مفاهيم القرآن في تفاسير علماء الأمة</dct:title>
    <dct:title xml:lang="en">Mafāhīm: Quranic concepts in classical tafsir</dct:title>
    <dct:title xml:lang="tr">Mafāhīm: Kur'an kavramları klasik tefsirlerde</dct:title>
    <dct:title xml:lang="de">Mafāhīm: Koranbegriffe in den klassischen Tefsiren</dct:title>
    <dct:creator>Kürşat Çifçi</dct:creator>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:comment xml:lang="de">Erweitert SemanticTafsir um mehrere Werke, zerlegte Aussage-Einheiten, werkübergreifende Deutungen, gelebte Begriffe (Mafhûm) und Prüfvermerke.</rdfs:comment>
  </rdf:Description>
